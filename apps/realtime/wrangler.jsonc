{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "iatrome-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "Room", "class_name": "Room" },
      { "name": "Limiter", "class_name": "Limiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Limiter"] }
  ],
  // Global per-IP rate limits (Workers Rate Limiting API). Period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "CONNECT_LIMITER", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
  ],
  "vars": {
    // Production: the site's origins. Preview deployments on Vercel are covered by the wildcard.
    "ALLOWED_ORIGINS": "https://iatrome.com,https://www.iatrome.com,https://*.vercel.app",
    "DEV_MODE": "false"
  },
  "observability": { "enabled": true }
}
